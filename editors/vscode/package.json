{
  "name": "vscode-zuv",
  "displayName": "Zuv Developer Tools",
  "description": "Language support, syntax highlighting, and LSP integration for Zuv",
  "version": "0.1.0",
  "publisher": "zuv-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuv-lang/zuv-tools.git"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=26.0.0"
  },
  "main": "./out/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zuv"
  ],
  "contributes": {
    "languages": [{
      "id": "zuv",
      "aliases": ["Zuv", "zuv"],
      "extensions": [".zv"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "zuv",
      "scopeName": "source.zuv",
      "path": "./syntaxes/zuv.tmLanguage.json"
    }],
    "snippets": [{
      "language": "zuv",
      "path": "./snippets/zuv.json"
    }]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "demo": "npm run compile && npm run copy-server",
    "copy-server": "node ./scripts/copy-server.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
