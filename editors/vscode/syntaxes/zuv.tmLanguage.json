{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zuv",
  "scopeName": "source.zuv",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-declarations" },
    { "include": "#return-arrow" },
    { "include": "#arrows" },
    { "include": "#builtins" },
    { "include": "#standard-modules" },
    { "include": "#function-calls" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#object-properties" },
    { "include": "#dot-members" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zuv",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zuv",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zuv",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zuv",
              "match": "\\\\([nrtbfv\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            },
            {
              "name": "invalid.illegal.unknown-escape.zuv",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zuv",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zuv",
              "match": "\\\\([nrtbfv\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s+([^\\{\\n\\r=]+)?(?=\\{)",
          "captures": {
            "1": { "name": "entity.name.function.zuv" },
            "2": { "name": "variable.parameter.zuv" }
          }
        },
        {
          "match": "\\b(main)\\s*\\{",
          "captures": {
            "1": { "name": "entity.name.function.zuv" }
          }
        }
      ]
    },
    "return-arrow": {
      "patterns": [
        {
          "name": "keyword.operator.return.zuv",
          "match": "->"
        }
      ]
    },
    "arrows": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.zuv",
          "match": "=>"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.zuv",
          "match": "\\b(prnt|lg|wrn|inf|err|sh|rF|wF|fE|sF|nw|sl|panic|assert)\\b"
        }
      ]
    },
    "standard-modules": {
      "patterns": [
        {
          "name": "support.class.zuv",
          "match": "\\b(str|arr|fs|time|math|io|sys|net|json)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.zuv" }
          }
        },
        {
          "match": "(=)\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s+(?:[\"'{\\(\\[0-9]|true|false|null|nil|[a-zA-Z_][a-zA-Z0-9_]*\\s*,|[a-zA-Z_][a-zA-Z0-9_]*\\s+[a-zA-Z0-9_\"'{\\(\\[]))",
          "captures": {
            "1": { "name": "keyword.operator.assignment.zuv" },
            "2": { "name": "entity.name.function.call.zuv" }
          }
        },
        {
          "match": "\\b(if|wh)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s+[a-zA-Z0-9_\"'{\\(\\[])",
          "captures": {
            "1": { "name": "keyword.control.zuv" },
            "2": { "name": "entity.name.function.call.zuv" }
          }
        },
        {
          "match": "(->)\\s*([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s+(?:[\"'{\\(\\[0-9]|true|false|null|nil|[a-zA-Z_][a-zA-Z0-9_]*\\s*,|[a-zA-Z_][a-zA-Z0-9_]*\\s+[a-zA-Z0-9_\"'{\\(\\[]))",
          "captures": {
            "1": { "name": "keyword.operator.return.zuv" },
            "2": { "name": "entity.name.function.call.zuv" }
          }
        },
        {
          "match": "^\\s*(?!(?:if|els|wh|fr|brk|cont|mch|rt|ret|asc|awt|spn|jn|wrk|imp|frm|as|exp|obj|mut|ok|err|fn|struct|type|class|enum|let|const|var|main|prnt|lg|wrn|inf|err|sh|rF|wF|fE|sF|nw|sl|panic|assert|true|false|null|nil)\\b)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s+[a-zA-Z0-9_\"'{\\(\\[])(?!.*=(?!=))",
          "captures": {
            "1": { "name": "entity.name.function.call.zuv" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zuv",
          "match": "\\b(if|els|wh|fr|brk|cont|mch|rt|ret)\\b"
        },
        {
          "name": "keyword.control.concurrency.zuv",
          "match": "\\b(asc|awt|spn|jn|wrk)\\b"
        },
        {
          "name": "keyword.control.import.zuv",
          "match": "\\b(imp|frm|as|exp)\\b"
        },
        {
          "name": "storage.type.zuv",
          "match": "\\b(obj|mut|ok|err|fn|struct|type|class|enum|let|const|var)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zuv",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.zuv",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.zuv",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.zuv",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.zuv",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.zuv",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.zuv",
          "match": "\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.zuv",
          "match": "\\+|-|\\*|/|%|&|\\||\\^|~|<<|>>"
        }
      ]
    },
    "object-properties": {
      "patterns": [
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "variable.other.property.zuv" }
          }
        }
      ]
    },
    "dot-members": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "support.function.method.zuv" }
          }
        }
      ]
    }
  }
}
